@{
    ViewData["Title"] = "F1 Race Live Dashboard";
}

<div class="dashboard-page">
    <header class="dashboard-header">
        <div class="header-main">
            <p class="eyebrow">Realtime ASP.NET dashboard</p>
            <h1>F1 Race Live Dashboard</h1>
            <p class="header-description">Prosta symulacja wyścigu F1 z live tabelą, logiem zdarzeń i panelem kierowcy.</p>

            <div class="control-panel">
                <button id="startRaceButton" class="control-button">Start</button>
                <button id="pauseRaceButton" class="control-button secondary-button">Pause</button>
                <button id="resumeRaceButton" class="control-button secondary-button">Resume</button>
                <button id="resetRaceButton" class="control-button secondary-button">Reset</button>
                <button id="speed1xButton" class="control-button secondary-button">Speed x1</button>
                <button id="speed2xButton" class="control-button secondary-button">Speed x2</button>
                <button id="speed4xButton" class="control-button secondary-button">Speed x4</button>
                <button id="speed8xButton" class="control-button secondary-button">Speed x8</button>
            </div>
        </div>

        <div class="top-stats">
            <div class="summary-card">
                <span class="summary-label">Status</span>
                <strong id="raceStatus">Loading...</strong>
            </div>
            <div class="summary-card">
                <span class="summary-label">Race Time</span>
                <strong id="raceTime">00:00</strong>
            </div>
            <div class="summary-card">
                <span class="summary-label">Leader</span>
                <strong id="leaderName">-</strong>
            </div>
            <div class="summary-card">
                <span class="summary-label">Active Drivers</span>
                <strong id="activeDriversCount">-</strong>
            </div>
        </div>
    </header>

    <main class="dashboard-grid">
        <section class="panel">
            <div class="panel-header">
                <h2>Leaderboard</h2>
                <span class="panel-note">Live classification</span>
            </div>

            <div class="table-wrapper">
                <table class="drivers-table">
                    <thead>
                        <tr>
                            <th>Pos</th>
                            <th>Change</th>
                            <th>Driver</th>
                            <th>Team</th>
                            <th>Lap</th>
                            <th>Progress</th>
                            <th>Best Lap</th>
                            <th>Last Lap</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="driversTableBody">
                        <tr>
                            <td colspan="9">Loading drivers...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <aside class="panel">
            <div class="panel-header">
                <h2>Driver Details</h2>
                <span class="panel-note">Click row to inspect</span>
            </div>

            <div class="details-box" id="driverDetailsBox">
                <p><strong>Name:</strong> Click a driver in the table</p>
                <p><strong>Team:</strong> -</p>
                <p><strong>Position:</strong> -</p>
                <p><strong>Status:</strong> -</p>
                <p><strong>Best Lap:</strong> -</p>
            </div>
        </aside>

        <section class="panel panel-full">
            <div class="panel-header">
                <h2>Race Events</h2>
                <span class="panel-note">Newest events at the top</span>
            </div>

            <div class="events-box" id="eventsBox">
                <div class="event-item">Loading events...</div>
            </div>
        </section>
    </main>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/race.js"></script>
}